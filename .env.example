# Every setting Suiro reads, without values. Only internal/config reads them.
# For local runs copy to .env (git-ignored) and fill in; in a cluster the Helm
# chart sets them. Secret values never go in this file.

# All programs
SUIRO_LOG_LEVEL=

# server
SUIRO_HTTP_ADDR=

# git-collector, renderer, cloud-collector
SUIRO_GRPC_ADDR=
