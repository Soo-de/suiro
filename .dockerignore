.github
.claude
CLAUDE.md
CLAUDE.local.md

.env
.env.*
*.pem
*.key
*.p12
*.pfx
kubeconfig
*.kubeconfig
.aws
*.tfstate
*.tfstate.*
*.tfvars

bin
dist
internal/gen
ui/node_modules
ui/dist
deploy
examples
**/testdata
coverage.*
*.test
*.out

.DS_Store
.vscode
.idea
